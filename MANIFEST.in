include LICENSE README.md .env.example
include config.py discordbot_chatgames.py .gitignore .gitattributes .python-version
include requirements.txt requirements-dev.txt uv.lock
recursive-include docs *.md
recursive-include lets_play *.py
global-exclude *.py[cod] *.db *.sqlite *.sqlite3 *-wal *-shm *-journal *.log .env .env.*
prune private
prune private_lists
prune wordlists
prune data
prune backups
include .env.example
