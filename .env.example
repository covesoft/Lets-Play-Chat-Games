# Copy to .env in the repository root. Keep real values out of Git.
# Only the token is required for the current live login scaffold.
CHATRULES_DISCORD_TOKEN=
CHATRULES_APP_ID=
ADMIN_IDS=

# Paths are relative to the project root; absolute external paths also work.
CHATRULES_DATABASE_PATH=data/lets_play.sqlite3
# Production lists must be private. Blank paths leave those features unavailable.
CHATRULES_PROFANITY_LIST_PATH=
CHATRULES_PHRASE_SUITABILITY_LIST_PATH=
CHATRULES_DING_EMOJI=
CHATRULES_BADGE_EMOJI_MAP_PATH=

CHATRULES_DEVELOPMENT_MODE=false
# Explicit opt-in; M0 also skips syncing an empty command tree.
CHATRULES_SYNC_COMMANDS=false

# Existing owner-supplied public links are defaults in lets_play/config.py.
# Optional overrides:
CHATRULES_LINK_OTHER_BOTS=
CHATRULES_LINK_THIS_BOT=
CHATRULES_LINK_GITHUB=
CHATRULES_LINK_DONATE=
# Supply either a full support URL or the existing invite-code setting.
CHATRULES_LINK_SUPPORT=
CHATRULES_SUPPORT_INVITE_CODE=
# Leave blank until the listing is actually approved and available.
CHATRULES_LINK_VOTE=
# Actual privacy/contact URL required before public gameplay release.
CHATRULES_PRIVACY_CONTACT_URL=
