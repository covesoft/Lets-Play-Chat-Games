# Copy to .env in the repository root. Keep real values out of Git.
# Only the token is required for login. The opening preview also needs development mode.
CHATGAMES_DISCORD_TOKEN=
CHATGAMES_APP_ID=
CHATGAMES_ADMIN_IDS=

# Paths are relative to the project root; absolute external paths also work.
CHATGAMES_DATABASE_PATH=data/lets_play.sqlite3
# Production lists must be private. Blank paths leave those features unavailable.
CHATGAMES_PROFANITY_LIST_PATH=
CHATGAMES_PHRASE_SUITABILITY_LIST_PATH=
CHATGAMES_DING_EMOJI=
CHATGAMES_BADGE_EMOJI_MAP_PATH=

CHATGAMES_DEVELOPMENT_MODE=false
# Set true for initial registration of the three preview application commands.
CHATGAMES_SYNC_COMMANDS=false

# Existing owner-supplied public links are defaults in lets_play/config.py.
# Optional overrides:
CHATGAMES_LINK_OTHER_BOTS=
CHATGAMES_LINK_THIS_BOT=
CHATGAMES_LINK_GITHUB=
CHATGAMES_LINK_DONATE=
# Supply either a full support URL or the invite-code setting.
CHATGAMES_LINK_SUPPORT=
CHATGAMES_SUPPORT_INVITE_CODE=
# Leave blank until the listing is actually approved and available.
CHATGAMES_LINK_VOTE=
# Actual privacy/contact URL required before public gameplay release.
CHATGAMES_PRIVACY_CONTACT_URL=
